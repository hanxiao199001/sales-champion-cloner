# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ASR - Alibaba Cloud Speech
ALIBABA_ACCESS_KEY_ID=your-access-key
ALIBABA_ACCESS_KEY_SECRET=your-access-secret

# App
APP_PASSWORD=your-secret-password
APP_HOST=0.0.0.0
APP_PORT=8000

# ASR quality threshold (0-100)
ASR_CONFIDENCE_THRESHOLD=80

# Playbook minimum recordings
PLAYBOOK_MIN_RECORDINGS=5
